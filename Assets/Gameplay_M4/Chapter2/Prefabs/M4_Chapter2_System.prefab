  openingDialogue:
  - "L\xDD TH\xD4NG:\nTr\u1EDDi s\u1EAFp t\u1ED1i r\u1ED3i. N\u1EBFu ch\xFA kh\xF4ng ch\xEA, h\xE3y theo ta v\u1EC1 nh\xE0 ngh\u1EC9 t\u1EA1m."
  - "TH\u1EA0CH SANH:\nT\xF4i xin \u0111a t\u1EA1 huynh. T\xF4i s\u1EBD \u0111i c\xF9ng huynh."
  - "L\xDD TH\xD4NG:\nNh\xE0 ta \u1EDF ngay ph\xEDa tr\u01B0\u1EDBc. Ch\xFA c\u1EE9 \u0111i theo ta nh\xE9."
  finalDialogue:
  - "L\xDD TH\xD4NG:\n\u0110\xE3 \u0111\u1EBFn nh\xE0 r\u1ED3i. T\u1EEB nay ch\xFAng ta k\u1EBFt ngh\u0129a anh em, c\xF9ng gi\xFAp \u0111\u1EE1 nhau nh\xE9!"
  - "TH\u1EA0CH SANH:\nT\xF4i xin k\u1EBFt ngh\u0129a c\xF9ng huynh. C\u1EA3m \u01A1n huynh \u0111\xE3 cho t\xF4i m\u1ED9t m\xE1i nh\xE0."
